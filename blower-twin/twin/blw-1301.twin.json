  "failure_modes": {
    "diffuser_fouling": {
      "label": "Diffuser fouling (biofilm / scale)",
      "cause": "Biofilm and scale on the EPDM membranes: higher dynamic wet pressure and fewer, larger bubbles (lower alpha F)",
      "detect": [
        "grid_pressure_residual_mbar",
        "air_ratio",
        "specific_energy_kwh_kg"
      ],
      "action": "Bump/flex the membranes (air bump) or acid-clean the grid; plan membrane replacement",
      "default_ramp_min": 15
    },
    "membrane_tear": {
      "label": "Torn membrane / broken grid pipe",
      "cause": "A split membrane or a cracked pipe lets air out as coarse bubbles: lower grid pressure, much less oxygen transfer, uneven DO",
      "detect": [
        "grid_pressure_residual_mbar",
        "air_ratio",
        "do_spread_mgl"
      ],
      "action": "Drain the zone, inspect the grid, replace torn discs / repair the pipe",
      "default_ramp_min": 10
    },
    "inlet_filter": {
      "label": "Inlet filter clogging",
      "cause": "Dust and pollen load the inlet filter mats: the blower sucks at lower pressure and uses more power",
      "detect": [
        "inlet_filter_dp_mbar",
        "power_residual_pct"
      ],
      "action": "Change the inlet filter mats",
      "default_ramp_min": 15
    },
    "bearing_wear": {
      "label": "Bearing / impeller wear",
      "cause": "Worn bearing or eroded impeller: more vibration, a hotter bearing and lower wire-to-air efficiency",
      "detect": [
        "vibration_mm_s",
        "bearing_temp_c",
        "power_residual_pct"
      ],
      "action": "Vibration analysis; service the bearing and impeller (Aerzen service)",
      "default_ramp_min": 15
    },
    "surge_approach": {
      "label": "Zone valve stuck part-closed (surge risk)",
      "cause": "A zone air valve sticks part-closed: the header loses more pressure and the blower runs closer to its surge line, especially at night",
      "detect": [
        "header_loss_residual_mbar",
        "surge_margin_pct",
        "discharge_pressure_mbar"
      ],
      "action": "Free the zone valve and check its actuator; review the most-open-valve logic",
      "default_ramp_min": 10
    },
    "do_probe_drift": {
      "label": "DO probe reads high",
      "cause": "A fouled or drifting control DO probe reads high: the controller gives too little air and the basin under-aerates",
      "detect": [
        "do_spread_mgl",
        "grid_pressure_residual_mbar",
        "do_outlet_mgl"
      ],
      "action": "Clean and calibrate the DO probe (luminescent cap check)",
      "default_ramp_min": 10
    },
    "vfd_overheating": {
      "label": "VFD cooling fault",
      "cause": "The VFD cabinet fan fails or its filter blocks: heat-sink and motor temperatures climb towards trip",
      "detect": [
        "vfd_temp_c",
        "motor_temp_c"
      ],
      "action": "Replace the cabinet fan / filter mats; check the room ventilation",
      "default_ramp_min": 15
    }
  },
