  "failure_modes": {
    "seat_plug_wear": {
      "label": "Seat and plug wear (cavitation erosion)",
      "cause": "Cavitation and wire-drawing erode the plug contour and seat: the valve passes more than its Kv at small openings",
      "detect": [
        "kv_ratio",
        "sigma",
        "body_vibration_mm_s"
      ],
      "action": "Replace plug and seat; review sizing (Kvs) and the network differential pressure at night",
      "default_ramp_min": 20
    },
    "stiction": {
      "label": "Stem stiction (packing friction)",
      "cause": "Dry or over-tightened packing: the stem sticks, then jumps, and the loop hunts",
      "detect": [
        "actuator_force_pct",
        "force_deviation_pct",
        "position_error_pct",
        "reversals"
      ],
      "action": "Service the stem seal; check stem for scoring",
      "default_ramp_min": 15
    },
    "gland_leak": {
      "label": "Stem seal (gland) leak",
      "cause": "Worn EPDM profile ring on the stem lets water escape",
      "detect": [
        "gland_leak_ml_min"
      ],
      "action": "Replace the stem seal (profile ring)",
      "default_ramp_min": 10
    },
    "actuator_fault": {
      "label": "Actuator gear / motor wear",
      "cause": "Worn gear train and motor: more power and heat for the same force, slower stroke",
      "detect": [
        "actuator_power_w",
        "actuator_temp_c",
        "position_error_pct"
      ],
      "action": "Replace or overhaul the EA-C actuator",
      "default_ramp_min": 15
    },
    "position_sensor_drift": {
      "label": "Position feedback drift",
      "cause": "Feedback potentiometer drifts: the reported opening no longer matches the plug",
      "detect": [
        "kv_ratio",
        "position_pct"
      ],
      "action": "Recalibrate the actuator (KSB parameterisation unit / PC tool)",
      "default_ramp_min": 10
    },
    "strainer_blockage": {
      "label": "Upstream strainer blockage",
      "cause": "Debris collects in the strainer: less pressure reaches the valve, which opens wider to compensate",
      "detect": [
        "strainer_kv_ratio",
        "position_pct",
        "flow_error_pct"
      ],
      "action": "Clean the strainer basket",
      "default_ramp_min": 20
    }
  },
