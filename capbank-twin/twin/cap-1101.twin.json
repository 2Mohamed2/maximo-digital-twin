  "failure_modes": {
    "element_failures": {
      "label": "Element failures (internal fuses blowing)",
      "cause": "Elements puncture one by one; each internal fuse isolates its element in microseconds. The group loses capacitance, the neutral current steps up and the remaining elements of that group carry more voltage",
      "detect": [
        "neutral_current_a",
        "failed_elements_est",
        "element_overvoltage_pct"
      ],
      "action": "Plan an outage: measure the units' capacitance, replace the unit with blown fuses before a third fuse blows",
      "default_ramp_min": 3
    },
    "can_bulging": {
      "label": "Can bulging (internal gassing)",
      "cause": "A unit with an internal fault gasses: the case swells, its pressure monitoring device operates and more element fuses blow until the unbalance relay trips the bank",
      "detect": [
        "pressure_switch_count",
        "neutral_current_a",
        "relay_status"
      ],
      "action": "Keep the bank out of service, replace the bulged unit, check the others for case deformation",
      "default_ramp_min": 2
    },
    "overvoltage_stress": {
      "label": "Overvoltage stress (bank left on at light load)",
      "cause": "The VAR controller leaves the bank in at night: the bus rises, the units run above rated voltage and the crest with harmonics approaches the IEEE 18 peak limit",
      "detect": [
        "unit_voltage_pu",
        "peak_voltage_pu",
        "bus_voltage_kv"
      ],
      "action": "Fix the VAR / voltage controller settings; switch the bank out at light load",
      "default_ramp_min": 2
    },
    "harmonic_resonance": {
      "label": "Harmonic resonance (7th)",
      "cause": "A network change lowers the short-circuit power, the bank's parallel resonance moves to the 7th harmonic and a nearby converter's 7th current is amplified in the bank",
      "detect": [
        "current_thd_pct",
        "current_h7_pct",
        "current_rms_pu",
        "resonance_order"
      ],
      "action": "Change the switching arrangement, detune with a series reactor or add a filter; review the harmonic study",
      "default_ramp_min": 2
    },
    "reactor_overheating": {
      "label": "Series reactor overheating",
      "cause": "A loose terminal or blocked air paths of the current-limiting reactor: it runs hotter than its current explains",
      "detect": [
        "reactor_temp_c",
        "reactor_residual_k"
      ],
      "action": "Infrared scan, tighten the terminals, clean the reactor; check for harmonic overload",
      "default_ramp_min": 3
    },
    "neutral_ct_fault": {
      "label": "Unbalance CT open (protection blind)",
      "cause": "The neutral CT's secondary circuit is open: the relay reads almost nothing while elements keep failing. The phase currents still drift apart",
      "detect": [
        "neutral_current_a",
        "phase_asymmetry_pct",
        "failed_from_asymmetry"
      ],
      "action": "Take the bank out, repair the CT circuit, then measure the units",
      "default_ramp_min": 3
    },
    "restrike": {
      "label": "Breaker restrike on opening",
      "cause": "A worn vacuum or SF6 interrupter restrikes when it opens the bank: the trapped charge drives overvoltages up to ~3 pu",
      "detect": [
        "last_switch_overvoltage_pu",
        "switching_ops"
      ],
      "action": "Overhaul or replace the capacitor switching breaker; check the surge arresters",
      "default_ramp_min": 1
    }
  },
