  "failure_modes": {
    "mudballs": {
      "label": "Mudballs / media fouling",
      "cause": "Incomplete backwashing leaves mud balls and coated grains: the clean bed loses porosity",
      "detect": [
        "headloss_residual_m",
        "deposit_ratio"
      ],
      "action": "Extended air scour backwash; inspect the bed (core sample), replace media if needed",
      "default_ramp_min": 6
    },
    "media_loss": {
      "label": "Anthracite loss",
      "cause": "Over-expansion during backwash carries anthracite over the wash troughs",
      "detect": [
        "bed_depth_m",
        "headloss_residual_m"
      ],
      "action": "Check backwash rate vs. water temperature, trough height; top up anthracite",
      "default_ramp_min": 6
    },
    "air_binding": {
      "label": "Air binding (negative head)",
      "cause": "Head loss in the anthracite exceeds the static head: dissolved air comes out and blocks pores",
      "detect": [
        "bed_pressure_head_m",
        "headloss_residual_m"
      ],
      "action": "Raise the water level over the media, backwash earlier, check for supersaturation",
      "default_ramp_min": 4
    },
    "short_circuiting": {
      "label": "Short-circuiting (cracks, wall channels)",
      "cause": "Cracks and wall separation let water bypass the media",
      "detect": [
        "headloss_residual_m",
        "effluent_turbidity_ntu",
        "particle_count_ml"
      ],
      "action": "Backwash with air scour, inspect wall gaps; filter to waste until stable",
      "default_ramp_min": 4
    },
    "underdrain_failure": {
      "label": "Underdrain / media retainer failure",
      "cause": "A broken lateral or I.M.S. cap: uneven backwash, boils, media in the clearwell",
      "detect": [
        "underdrain_ratio",
        "expansion_ratio",
        "particle_count_ml"
      ],
      "action": "Take the cell out of service; inspect laterals and caps",
      "default_ramp_min": 5
    },
    "valve_sticking": {
      "label": "Effluent control valve sticking",
      "cause": "Worn actuator or packing: the rate-control valve sticks and jumps, flow hunts",
      "detect": [
        "flow_error_pct",
        "effluent_valve_pct"
      ],
      "action": "Service the valve actuator and positioner; retune the level/flow loop",
      "default_ramp_min": 3
    },
    "coagulation_upset": {
      "label": "Coagulation upset (weak floc)",
      "cause": "Wrong coagulant dose or pH: fine floc penetrates deep, head loss climbs fast, early breakthrough",
      "detect": [
        "deposit_ratio",
        "effluent_turbidity_ntu",
        "particle_count_ml"
      ],
      "action": "Jar test; correct coagulant / polymer dose and pH; shorten runs",
      "default_ramp_min": 5
    },
    "turbidimeter_drift": {
      "label": "Turbidimeter fouling / drift",
      "cause": "Fouled flow cell or lamp drift: the turbidimeter reads high while the water is clean",
      "detect": [
        "effluent_turbidity_ntu",
        "particle_count_ml"
      ],
      "action": "Clean and recalibrate the turbidimeter (formazin / StablCal)",
      "default_ramp_min": 3
    }
  },
