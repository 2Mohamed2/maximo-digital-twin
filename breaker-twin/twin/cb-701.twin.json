  "failure_modes": {
    "sf6_leak": {
      "label": "SF6 leak",
      "cause": "A leaking flange seal or density-monitor fitting: the gas density falls. Below the alarm density the breaker must be refilled; at the lockout density it may no longer interrupt and is blocked",
      "detect": [
        "sf6_p20_calc_mpa",
        "sf6_density_p20_mpa",
        "density_contact"
      ],
      "action": "Locate the leak (camera / sniffer), repair the seal, refill to 0.70 MPa abs at 20 C; report the SF6 emission",
      "default_ramp_min": 4
    },
    "contact_wear": {
      "label": "Contact wear (repeated fault trips)",
      "cause": "A fault-prone line makes the breaker interrupt short-circuit currents again and again: the arcing contacts and nozzle erode, and the main contacts heat up",
      "detect": [
        "wear_max_pct",
        "wear_l2_pct",
        "pole_residual_max_k"
      ],
      "action": "Plan an interrupter overhaul (arcing contacts, nozzle); clear the line fault cause",
      "default_ramp_min": 4
    },
    "mechanism_lubrication": {
      "label": "Slow mechanism (lubrication)",
      "cause": "Grease in the operating mechanism has aged or the linkage is corroded: opening and closing get slower, which lengthens the arcing time and stresses the interrupter",
      "detect": [
        "open_time_dev_ms",
        "close_time_dev_ms"
      ],
      "action": "Service the operating mechanism: clean and re-lubricate the linkage and latches, check the damper",
      "default_ramp_min": 3
    },
    "trip_coil": {
      "label": "Trip coil degradation",
      "cause": "Shorted turns, a corroded terminal or a sticky plunger in the trip coil: less current, a slower release of the latch, and in the end a breaker that will not trip",
      "detect": [
        "trip_coil_ratio",
        "open_time_dev_ms"
      ],
      "action": "Measure the trip coil resistance and the trip circuit; replace the coil; check the second trip coil",
      "default_ramp_min": 3
    },
    "spring_motor": {
      "label": "Spring charging motor fault",
      "cause": "Worn motor brushes or gearbox: the closing spring takes longer to charge and the motor draws more current. After an O-0.3 s-CO trip the breaker may not be ready to close again",
      "detect": [
        "charge_time_ratio",
        "spring_motor_current_a"
      ],
      "action": "Overhaul or replace the charging motor and gearbox; check the motor supply",
      "default_ramp_min": 3
    },
    "heater_fault": {
      "label": "Cabinet heater failure",
      "cause": "The anti-condensation heater in the mechanism cabinet has failed: humidity rises, water condenses on the mechanism and auxiliary contacts, corrosion follows",
      "detect": [
        "heater_current_a",
        "cabinet_humidity_pct"
      ],
      "action": "Replace the heater and its thermostat; dry the cabinet and inspect for corrosion",
      "default_ramp_min": 3
    },
    "density_monitor_drift": {
      "label": "Density monitor drift",
      "cause": "The temperature-compensated density monitor reads high: it would not alarm on a real leak. The twin compensates the raw pressure and temperature itself and sees the difference",
      "detect": [
        "density_monitor_dev_mpa"
      ],
      "action": "Check the density monitor against a calibrated reference; replace it",
      "default_ramp_min": 3
    }
  },
