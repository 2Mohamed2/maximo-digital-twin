  "failure_modes": {
    "cooling_degraded": {
      "label": "Cooling degraded (fins blocked)",
      "cause": "Corrugated fins fouled, painted over or boxed in: the tank sheds less heat, so the top oil runs hotter than IEC 60076-7 expects for the same load and ambient",
      "detect": [
        "top_oil_residual_k",
        "top_oil_temp_c",
        "wti_temp_c"
      ],
      "action": "Clean the fins, restore free air around the tank; check the enclosure ventilation",
      "default_ramp_min": 3
    },
    "overload_ageing": {
      "label": "Sustained overload (paper ageing)",
      "cause": "Load kept above 1.2 pu: the winding hot spot passes 120 C, the paper ages many times faster and gives off CO and CO2",
      "detect": [
        "load_eq_pu",
        "wti_temp_c",
        "ageing_rate_v",
        "dga_co_ppm"
      ],
      "action": "Shift load to a neighbouring substation or upgrade the transformer; record the loss of life",
      "default_ramp_min": 3
    },
    "thermal_fault_core": {
      "label": "Thermal fault (core / connection hot spot)",
      "cause": "A poor joint or a circulating-current loop in the core heats the oil locally: methane first, then ethylene as the temperature passes 700 C (Duval T1 -> T3). The WTI cannot see it",
      "detect": [
        "dga_ch4_ppm",
        "dga_c2h4_ppm",
        "duval_zone",
        "ieee_condition"
      ],
      "action": "Plan an internal inspection: check winding and tap-changer connections, core earthing and clamping",
      "default_ramp_min": 3
    },
    "partial_discharge": {
      "label": "Partial discharge",
      "cause": "Voids or a sharp edge in the insulation discharge in the oil: hydrogen dominates with a trace of methane (Duval PD)",
      "detect": [
        "dga_h2_ppm",
        "duval_zone"
      ],
      "action": "Confirm with an acoustic or UHF PD test; plan an outage and drying/repair",
      "default_ramp_min": 2
    },
    "arcing": {
      "label": "Arcing (high-energy discharge)",
      "cause": "A flashover between turns or to earth: acetylene and hydrogen jump (Duval D1/D2); at full severity the protection relay trips the transformer",
      "detect": [
        "dga_c2h2_ppm",
        "dga_h2_ppm",
        "duval_zone",
        "relay_status"
      ],
      "action": "Do not re-energise: test (ratio, winding resistance, insulation) and repair or replace",
      "default_ramp_min": 2
    },
    "moisture_ingress": {
      "label": "Moisture ingress (seal leak)",
      "cause": "A failing gasket lets humid air in: water in oil rises (more when warm), oxygen rises, breakdown strength falls and the paper ages faster",
      "detect": [
        "moisture_ppm",
        "dga_o2_ppm"
      ],
      "action": "Find and replace the seal; dry the oil (and the active part if the paper is wet)",
      "default_ramp_min": 3
    },
    "oil_leak": {
      "label": "Oil leak (hermetic tank)",
      "cause": "A weeping weld, valve or bushing gasket: the oil level and the tank pressure fall below what the oil temperature explains",
      "detect": [
        "oil_level_pct",
        "tank_pressure_bar",
        "pressure_residual_bar"
      ],
      "action": "Locate and fix the leak, top up with dried oil, check the gas/pressure relay",
      "default_ramp_min": 3
    }
  },
