  "failure_modes": {
    "coil_scaling": {
      "label": "Coil scaling (external)",
      "cause": "Mineral scale on the outside of the coil tubes insulates them from the spray film",
      "detect": [
        "out_temp_deviation_k",
        "capacity_ratio_pct",
        "fan_speed_pct"
      ],
      "action": "Inspect and descale the coil; review water treatment and cycles",
      "default_ramp_min": 30
    },
    "nozzle_blockage": {
      "label": "Spray nozzle blockage",
      "cause": "Debris and scale plug spray nozzles: dry patches on the coil",
      "detect": [
        "spray_pressure_bar",
        "spray_flow_m3h",
        "nozzle_k_ratio",
        "out_temp_deviation_k"
      ],
      "action": "Clean spray branches and nozzles; check basin strainer",
      "default_ramp_min": 20
    },
    "fan_bearing": {
      "label": "Fan bearing wear",
      "cause": "Lubrication loss and wear in the fan shaft bearings",
      "detect": [
        "fan_vib_mm_s",
        "fan_bearing_temp_c"
      ],
      "action": "Grease or replace fan bearings; check alignment",
      "default_ramp_min": 20
    },
    "belt_slip": {
      "label": "Fan belt slip",
      "cause": "Worn or loose V-belts: the fan turns slower than the motor drives it",
      "detect": [
        "fan_rpm",
        "belt_slip_pct",
        "fan_power_kw",
        "out_temp_deviation_k"
      ],
      "action": "Re-tension or replace the belts",
      "default_ramp_min": 15
    },
    "fan_motor_winding": {
      "label": "Fan motor winding / supply imbalance",
      "cause": "Insulation ageing or a weak phase: unbalanced currents heat the winding",
      "detect": [
        "fan_current_imbalance_pct",
        "fan_winding_temp_c",
        "fan_power_kw"
      ],
      "action": "Megger the motor, check supply and terminals",
      "default_ramp_min": 20
    },
    "drift_eliminator": {
      "label": "Drift eliminator damage",
      "cause": "Displaced or broken eliminator blades let spray droplets escape with the air",
      "detect": [
        "makeup_flow_m3h",
        "unaccounted_water_m3h"
      ],
      "action": "Re-seat or replace eliminator sections",
      "default_ramp_min": 15
    },
    "water_treatment": {
      "label": "Blowdown failure (water treatment)",
      "cause": "Blowdown valve stuck closed: dissolved solids concentrate in the basin",
      "detect": [
        "conductivity_us_cm",
        "blowdown_flow_m3h",
        "cycles_of_concentration"
      ],
      "action": "Free the blowdown valve; check the conductivity controller",
      "default_ramp_min": 10
    }
  },
