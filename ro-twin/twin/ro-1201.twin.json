  "failure_modes": {
    "biofouling": {
      "label": "Biofouling (lead elements)",
      "cause": "Biofilm grows in the feed spacer of the first elements: the feed-concentrate pressure drop climbs first, permeate flow follows",
      "detect": [
        "ndp_norm_pct",
        "npf_pct",
        "membrane_feed_pressure_bar"
      ],
      "action": "Clean in place (high-pH clean first); review chlorination/dechlorination and the pretreatment SDI",
      "default_ramp_min": 3
    },
    "scaling": {
      "label": "Scaling (tail elements)",
      "cause": "Sparingly soluble salts (CaCO3, CaSO4) precipitate where the brine is most concentrated: permeate flow falls and salt passage rises at the tail, pressure drop barely moves",
      "detect": [
        "npf_pct",
        "nsp_pct",
        "ndp_norm_pct"
      ],
      "action": "Clean in place (low-pH clean); check the antiscalant dose and the recovery",
      "default_ramp_min": 3
    },
    "oxidation": {
      "label": "Membrane oxidation (chlorine breakthrough)",
      "cause": "Dechlorination (SBS) fails and free chlorine reaches the polyamide: ORP jumps, then flow and salt passage both rise for good",
      "detect": [
        "feed_orp_mv",
        "nsp_pct",
        "npf_pct"
      ],
      "action": "Stop the train, restore SBS dosing; autopsy one element; damaged elements must be replaced",
      "default_ramp_min": 2
    },
    "oring_leak": {
      "label": "O-ring / interconnector leak (bank 3)",
      "cause": "A rolled or cut interconnector O-ring lets feed into the permeate tube of one vessel: the permeate of that bank turns salty while the train flow is normal",
      "detect": [
        "bank_tds_ratio",
        "bank3_permeate_tds_mgl",
        "permeate_tds_mgl"
      ],
      "action": "Probe the vessels of bank 3 (permeate conductivity profile), replace the O-rings / interconnector",
      "default_ramp_min": 2
    },
    "hp_pump_wear": {
      "label": "HP pump wear",
      "cause": "Impeller and wear-ring wear in the multi-stage HP pump: the same head and flow take more power",
      "detect": [
        "hp_pump_eff_dev_pts",
        "hp_power_kw",
        "sec_kwh_m3"
      ],
      "action": "Plan an overhaul: wear rings, impellers, balance drum; check the vibration trend",
      "default_ramp_min": 3
    },
    "erd_leakage": {
      "label": "Energy recovery device leakage / mixing",
      "cause": "Worn PX rotor or seals: more lubrication flow goes to the brine, more brine mixes into the membrane feed, the booster works harder",
      "detect": [
        "px_eff_pct",
        "px_leakage_pct",
        "px_mixing_pct"
      ],
      "action": "Check PX flow balance and lubrication flow; inspect the rotor and sleeve of the worst unit",
      "default_ramp_min": 3
    },
    "cartridge_clogging": {
      "label": "Cartridge filter clogging",
      "cause": "Solids from the pretreatment load the 5-micron cartridges: the filter dP rises and the HP pump and PX suction pressure fall",
      "detect": [
        "cf_dp_bar",
        "hp_suction_pressure_bar"
      ],
      "action": "Change the cartridges; look upstream for media filter or coagulation upsets",
      "default_ramp_min": 3
    },
    "feed_temperature": {
      "label": "Warm intake (not a fault)",
      "cause": "The seawater warms 7 C (season, outfall recirculation): the membranes pass more water and more salt, so feed pressure falls and permeate salinity rises. The normalised values stay flat, so the twin raises no alarm",
      "detect": [
        "feed_temp_c",
        "tcf",
        "npf_pct",
        "nsp_pct"
      ],
      "action": "None: normalisation separates temperature from membrane condition",
      "default_ramp_min": 3
    }
  },
