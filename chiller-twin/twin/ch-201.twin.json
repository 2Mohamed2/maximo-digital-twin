  "failure_modes": {
    "cond_fouling": {
      "label": "Condenser tube fouling / scaling",
      "cause": "Scale and biofilm in condenser-water tubes raise thermal resistance",
      "detect": [
        "cond_approach_k",
        "cond_pressure_bar",
        "power_kw",
        "discharge_temp_c"
      ],
      "action": "Clean condenser tubes (brush or chemical); check water treatment",
      "default_ramp_min": 30
    },
    "evap_fouling": {
      "label": "Evaporator fouling",
      "cause": "Dirt and biofilm in the chilled-water circuit",
      "detect": [
        "evap_approach_k",
        "evap_sat_temp_c",
        "cooling_kw"
      ],
      "action": "Clean evaporator; check chilled-water strainers and treatment",
      "default_ramp_min": 30
    },
    "low_charge": {
      "label": "Refrigerant undercharge (leak)",
      "cause": "A refrigerant leak reduces the charge; the evaporator starves",
      "detect": [
        "superheat_k",
        "subcooling_k",
        "evap_sat_temp_c",
        "cooling_kw"
      ],
      "action": "Leak test, repair and recharge (F-gas record)",
      "default_ramp_min": 30
    },
    "noncondensables": {
      "label": "Non-condensable gases in the circuit",
      "cause": "Air or nitrogen left after service raises head pressure",
      "detect": [
        "subcooling_k",
        "cond_pressure_bar",
        "cond_approach_k",
        "power_kw"
      ],
      "action": "Purge non-condensables; check the service procedure",
      "default_ramp_min": 20
    },
    "compressor_wear": {
      "label": "Compressor rotor / bearing wear (internal leakage)",
      "cause": "Rotor tip and bearing wear increase internal leakage",
      "detect": [
        "capacity_deviation_pct",
        "discharge_temp_c",
        "vib_mm_s"
      ],
      "action": "Compressor inspection; plan an overhaul",
      "default_ramp_min": 30
    },
    "oil_filter": {
      "label": "Oil filter clogging",
      "cause": "Oil degradation and debris load the filter",
      "detect": [
        "oil_filter_dp_bar",
        "oil_temp_c"
      ],
      "action": "Replace the oil filter; oil analysis",
      "default_ramp_min": 20
    },
    "motor_winding": {
      "label": "Motor winding / supply imbalance",
      "cause": "Insulation degradation or phase imbalance",
      "detect": [
        "current_imbalance_pct",
        "winding_temp_c"
      ],
      "action": "Insulation test; check supply and terminals",
      "default_ramp_min": 25
    },
