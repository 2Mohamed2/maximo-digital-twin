  "twin_model": {
    "$comment": "Physics-based expectations computed INSIDE Monitor (PythonExpression functions generated from the design block). The simulator never sends these: the twin computes them from measured flow and speed, so a gap between expected and measured is evidence of degradation.",
    "calculations": [
      {
        "metric": "speed_ratio",
        "label": "Speed ratio n/n0",
        "formula": "speed / rated_speed"
      },
      {
        "metric": "bep_ratio",
        "label": "Flow / BEP flow at current speed",
        "formula": "Q / (Q_bep * s)"
      },
      {
        "metric": "head_expected_m",
        "label": "Expected head (design curve, affinity laws)",
        "formula": "a*s^2 + b*s*Q + c*Q^2"
      },
      {
        "metric": "head_deviation_pct",
        "label": "Head deviation from design",
        "formula": "(H_meas - H_exp) / H_exp * 100"
      },
      {
        "metric": "eff_expected_pct",
        "label": "Expected efficiency",
        "formula": "eta_bep * (2x - x^2) * 100, x = bep_ratio"
      },
      {
        "metric": "eff_deviation_pts",
        "label": "Efficiency deviation (points)",
        "formula": "eta_meas - eta_exp"
      },
      {
        "metric": "npshr_m",
        "label": "NPSH required at operating point",
        "formula": "(n0 + n2*x^2) * s^2"
      },
      {
        "metric": "npsh_margin_m",
        "label": "NPSH margin",
        "formula": "NPSHa - NPSHr"
      },
      {
        "metric": "specific_energy_kwh_m3",
        "label": "Specific energy",
        "formula": "P_elec / Q"
      },
      {
        "metric": "wire_to_water_pct",
        "label": "Wire-to-water efficiency",
        "formula": "P_hyd / P_elec * 100"
      }
    ],
    "limits": {
      "$comment": "Site settings for alerts. Vibration values are example site limits, not quoted from ISO 20816-7.",
      "vib_alert_mm_s": 4.5,
      "vib_trip_mm_s": 7.1,
      "bearing_alert_c": 85,
      "bearing_trip_c": 95,
      "winding_alert_c": 140,
      "winding_trip_c": 155,
      "envelope_alert_ge": 2.0,
      "npsh_margin_alert_m": 1.0,
      "bep_ratio_low": 0.7,
      "bep_ratio_high": 1.2,
      "head_deviation_alert_pct": -5.0,
      "eff_deviation_alert_pts": -4.0,
      "seal_leak_alert_mlmin": 30,
      "current_imbalance_alert_pct": 5.0,
      "fluid_temp_trip_c": 70
    }
  },
  "failure_modes": {
    "$comment": "FMEA-style catalogue. 'detect' lists the symptoms in the order they appear on the P-F curve (earliest first). The simulator injects these; the twin should detect them in that order.",
    "bearing_de": {
      "label": "DE bearing outer race defect",
      "cause": "Fatigue / lubrication",
      "detect": [
        "vib_de_envelope",
        "vib_de_accel_pk",
        "vib_de_vel_rms",
        "bearing_de_temp_c"
      ],
      "action": "Plan bearing replacement; check lubrication",
      "manage_problem": "BEARING",
      "default_ramp_min": 30
    },
    "cavitation": {
      "label": "Cavitation from suction strainer blockage",
      "cause": "Strainer fouling raises suction loss, NPSHa falls below the margin",
      "detect": [
        "suction_pressure_bar",
        "npsh_margin_m",
        "vib_de_accel_pk",
        "head_deviation_pct"
      ],
      "action": "Clean suction strainer; review suction conditions",
      "manage_problem": "CAVITATION",
      "default_ramp_min": 15
    },
    "impeller_wear": {
      "label": "Impeller and wear ring wear",
      "cause": "Erosion opens wear-ring clearance; recirculation lowers head and efficiency",
      "detect": [
        "head_deviation_pct",
        "eff_deviation_pts",
        "specific_energy_kwh_m3",
        "speed_rpm"
      ],
      "action": "Plan wear ring / impeller renewal; energy case",
      "manage_problem": "WEAR",
      "default_ramp_min": 30
    },
    "misalignment": {
      "label": "Shaft misalignment",
      "cause": "Thermal growth / soft foot / poor alignment",
      "detect": [
        "vib_de_2x",
        "vib_de_vel_rms",
        "bearing_de_temp_c"
      ],
      "action": "Laser alignment; check soft foot",
      "manage_problem": "ALIGN",
      "default_ramp_min": 20
    },
    "imbalance": {
      "label": "Rotor imbalance",
      "cause": "Impeller fouling / damage",
      "detect": [
        "vib_de_1x",
        "vib_de_vel_rms"
      ],
      "action": "Clean / balance impeller",
      "manage_problem": "IMBALANCE",
      "default_ramp_min": 20
    },
    "seal_leak": {
      "label": "Mechanical seal leakage",
      "cause": "Face wear / dry running",
      "detect": [
        "seal_temp_c",
        "seal_leak_mlmin"
      ],
      "action": "Plan seal replacement",
      "manage_problem": "SEAL",
      "default_ramp_min": 20
    },
    "motor_winding": {
      "label": "Motor winding / supply imbalance",
      "cause": "Insulation degradation or supply phase imbalance",
      "detect": [
        "current_imbalance_pct",
        "winding_temp_c"
      ],
      "action": "Insulation test (IR / PI); check supply",
      "manage_problem": "MOTOR",
      "default_ramp_min": 25
    },
    "valve_closed": {
      "label": "Discharge valve closed (dead-head)",
      "cause": "Operating error",
      "detect": [
        "flow_m3h",
        "bep_ratio",
        "fluid_temp_c"
      ],
      "action": "Open valve; protection trips on fluid temperature",
      "manage_problem": "OPERATION",
      "default_ramp_min": 1
    }
  },
