  "failure_modes": {
    "soil_drying": {
      "label": "Soil drying at the road crossing",
      "cause": "Heat from the cables dries the backfill around the ducts under the road: its thermal resistivity climbs from 1.2 towards 2.5 K.m/W, the crossing runs hotter for the same load and can run away thermally",
      "detect": [
        "dts_seg07_c",
        "crossing_residual_k",
        "conductor_temp_c",
        "rating_utilisation"
      ],
      "action": "Derate the circuit now; re-bed the crossing in a stabilised, low-resistivity backfill (or add a water/cooling measure)",
      "default_ramp_min": 3
    },
    "joint_pd": {
      "label": "Partial discharge in joint J4",
      "cause": "A void or a contaminated interface in the pre-moulded joint discharges every cycle; the HFCT on the earth lead sees it long before the joint fails",
      "detect": [
        "pd_joint_pc"
      ],
      "action": "Confirm with a UHF / acoustic PD survey; plan a joint replacement in the next outage",
      "default_ramp_min": 2
    },
    "cross_bonding_fault": {
      "label": "Cross-bonding fault (link box J2)",
      "cause": "Water in link box J2 shorts the cross-bonding: the screens act as if solidly bonded, circulating currents flow and heat the whole major section",
      "detect": [
        "sheath_current_a",
        "sheath_ratio",
        "sheath_voltage_v",
        "conductor_temp_c"
      ],
      "action": "Open and dry link box J2, replace the sheath voltage limiters, seal the box; verify the bonding with a sheath current test",
      "default_ramp_min": 2
    },
    "termination_overheating": {
      "label": "Sealing end A connector overheating",
      "cause": "A loose or corroded compression connector at the outdoor sealing end: contact resistance grows and the lug runs hot",
      "detect": [
        "term_a_temp_c",
        "term_residual_k"
      ],
      "action": "Thermographic check, then re-make the connector in the next outage",
      "default_ramp_min": 3
    },
    "overload": {
      "label": "Sustained overload",
      "cause": "Load transferred from a parallel circuit stays above the circuit's dynamic rating: the conductor heads for 90 C at the crossing",
      "detect": [
        "load_eq_a",
        "rating_utilisation",
        "conductor_temp_c"
      ],
      "action": "Re-dispatch or shed load; use the dynamic rating, not the static one, to decide how long it can last",
      "default_ramp_min": 3
    },
    "jacket_damage": {
      "label": "Outer jacket damage",
      "cause": "Third-party digging scraped the jacket: water reaches the screen and leakage current through the sheath voltage limiters rises; corrosion follows",
      "detect": [
        "sheath_leakage_ma"
      ],
      "action": "Locate the fault with a sheath fault locator, repair the jacket before the screen corrodes",
      "default_ramp_min": 2
    },
    "dts_fibre_break": {
      "label": "DTS fibre break",
      "cause": "The DTS fibre is cut or a splice fails: the interrogator only sees the fibre up to the break; the route beyond is blind. This is a sensor fault, not a cable fault",
      "detect": [
        "dts_fibre_km",
        "dts_seg07_c"
      ],
      "action": "OTDR the fibre, repair the splice; meanwhile rate the circuit from the load model only",
      "default_ramp_min": 1
    }
  },
