  "failure_modes": {
    "compressor_fouling": {
      "label": "Compressor fouling",
      "cause": "Airborne dust, salt and oil mist that pass the filter stick to the compressor blades: less air, lower compressor efficiency",
      "detect": [
        "eta_c_dev_pts",
        "hr_dev_pct",
        "cdp_dev_pct",
        "egt_dev_k"
      ],
      "action": "On-line wash now; schedule an off-line (crank) wash, which restores virtually all of the lost power",
      "default_ramp_min": 30
    },
    "hot_section": {
      "label": "Hot-section degradation",
      "cause": "Erosion, coating loss or blocked cooling passages in the compressor turbine: lower turbine efficiency",
      "detect": [
        "egt_dev_k",
        "hr_dev_pct",
        "ngg_expected_pct"
      ],
      "action": "Borescope inspection of the combustor and compressor turbine; plan the hot-section overhaul",
      "default_ramp_min": 30
    },
    "burner_fault": {
      "label": "Burner / fuel nozzle fault (one can hot)",
      "cause": "A partly blocked or eroded fuel nozzle sends a hot streak downstream of one of the six combustor cans",
      "detect": [
        "egt_spread_k",
        "tc_high_dev_k"
      ],
      "action": "Check the burner of the hot sector (swirl-corrected); inspect the can and its transition duct",
      "default_ramp_min": 10
    },
    "thermocouple_fault": {
      "label": "Exhaust thermocouple fault",
      "cause": "One exhaust thermocouple (TC5) drifts low or goes open-circuit: the sensor, not the engine",
      "detect": [
        "tc_low_dev_k",
        "egt_spread_k"
      ],
      "action": "Replace the thermocouple; do not chase a combustion problem",
      "default_ramp_min": 5
    },
    "inlet_filter": {
      "label": "Inlet filter clogging",
      "cause": "Dust load on the filter elements raises the pressure drop; less air reaches the compressor",
      "detect": [
        "inlet_filter_dp_pa"
      ],
      "action": "Pulse-clean or replace the filter elements",
      "default_ramp_min": 20
    },
    "bearing_wear": {
      "label": "Power turbine bearing wear",
      "cause": "Worn tilting-pad bearing on the power turbine: shaft vibration and drain temperature rise",
      "detect": [
        "pt_prox_um",
        "brg_pt_temp_c"
      ],
      "action": "Plan a bearing inspection; trend the shaft orbit; check oil quality",
      "default_ramp_min": 20
    },
    "lube_cooler": {
      "label": "Lube oil cooler fouling",
      "cause": "Fouled oil cooler or a failed cooler fan: the lube oil header temperature rises and every bearing runs hotter",
      "detect": [
        "lube_oil_temp_c",
        "brg_gg_temp_c"
      ],
      "action": "Clean the lube oil cooler; check the cooler fans and the thermostatic valve",
      "default_ramp_min": 15
    }
  },
